KAPSO_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
# Optional. Defaults to openai/gpt-5.4
PROVIDER_MODEL_NAME=

# Advanced optional sandbox settings. Leave these empty for the normal scaffold.
# Set to true/false to explicitly enable or disable sandbox for the support agent node.
AGENT_SANDBOX_ENABLED=
# Optional. When set, workflow.ts includes one GitHub repository resource in the agent node.
AGENT_SANDBOX_GITHUB_REPO_URL=
# Optional. Defaults to main.
AGENT_SANDBOX_GITHUB_REPO_BRANCH=
# Optional. Leave empty for public repos.
AGENT_SANDBOX_GITHUB_PAT=
# Optional. Defaults to allow_list.
AGENT_SANDBOX_NETWORK_MODE=
# Optional. Comma-separated or newline-separated list of extra hosts for allow_list mode.
AGENT_SANDBOX_ALLOWED_OUTBOUND_HOSTS=
